/* === БАЗОВЫЕ СТИЛИ И СБРОС === */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    line-height: 1.5;
    color: #000;
    background-color: #fff;
}

/* Контейнер: ограничивает ширину 960px и центрирует */
.container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 15px;
}

/* ==================== ШАПКА (HEADER) ==================== */
#main-header {
    width: 100%; /* Тянется на всю ширину окна */
    padding: 20px 0;
    border-bottom: 2px solid #000; /* Рамка как на макете */
}

/* Внутренняя структура шапки: Лого и Название слева, Меню справа */
.header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.header-left {
    display: flex;
    align-items: center;
    gap: 20px;
}

/* Логотип (круг) */
#logo {
    width: 70px;
    height: 70px;
    border-radius: 50%; /* Делает круг */
    border: 2px solid #000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: bold;
}

/* Название сайта */
#site-name {
    font-size: 20px;
    font-weight: bold;
}

/* Меню навигации (NAV) */
#main-nav {
    display: flex;
    gap: 15px;
}

#main-nav a {
    text-decoration: none;
    color: #000;
    font-size: 16px;
    padding: 5px 10px;
    border: 1px solid #000; /* Рамка вокруг ссылок как на макете */
}

#main-nav a:hover {
    background-color: #eee;
}

/* ==================== ОСНОВНОЙ КОНТЕНТ ==================== */
main {
    padding: 30px 0;
    display: flex;
    flex-direction: column;
    gap: 30px; /* Расстояние между блоками */
}

/* Стиль для блоков (Список, Таблица, Форма) */
.content-block {
    background-color: #7fb3e0; /* Синий цвет как на макете */
    padding: 20px;
    border: 2px solid #000; /* Рамка как на макете */
}

.content-block h2 {
    margin-bottom: 15px;
    font-size: 20px;
}

/* === Ссылки === */
.content-block a {
    color: #000;
    text-decoration: underline;
}

.content-block ul {
    margin-left: 20px;
}

.content-block li {
    margin-bottom: 5px;
}

/* === ТАБЛИЦА === */
table {
    width: 100%;
    border-collapse: collapse; /* Убирает двойные рамки */
    background-color: #fff;
}

th, td {
    border: 2px solid #000;
    padding: 10px;
    text-align: left;
}

th {
    background-color: #f0f0f0; /* Светлый фон для заголовков */
    font-weight: bold;
}

/* Четные и нечетные строки */
tr.even {
    background-color: #e0e0e0; /* Темнее */
}

tr.odd {
    background-color: #ffffff; /* Светлее */
}

/* === ФОРМА === */
.form-group {
    margin-bottom: 15px;
}

.form-group label {
    display: block;
    font-weight: bold;
    margin-bottom: 5px;
}

/* Поля ввода */
input[type="text"],
input[type="tel"],
input[type="email"],
input[type="date"],
textarea,
select {
    width: 100%;
    padding: 8px;
    border: 2px solid #000;
    font-size: 15px;
    font-family: inherit;
    background-color: #fff;
}

textarea {
    resize: vertical;
    min-height: 80px;
}

/* Радиокнопки и чекбоксы (выстраиваем в ряд) */
.radio-group, .checkbox-group {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.radio-group label, .checkbox-group label {
    font-weight: normal;
    margin-bottom: 0;
}

/* Кнопка */
button {
    background-color: #fff;
    color: #000;
    border: 2px solid #000;
    padding: 10px 25px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background-color: #eee;
}

/* ==================== ПОДВАЛ (FOOTER) ==================== */
#main-footer {
    width: 100%; /* Тянется на всю ширину окна */
    padding: 20px 0;
    border-top: 2px solid #000; /* Рамка как на макете */
    font-weight: bold;
}
